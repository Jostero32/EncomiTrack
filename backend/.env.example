# ============================================================================
# Backend (API) · aplicación de Dokploy con backend/Dockerfile
# Pegue estas variables en la pestaña "Environment" de la aplicación.
# Todas tienen ya este valor por defecto en el Dockerfile.
# ============================================================================

# Subruta pública: la API responde en https://<dominio>/liquidacion/api
BASE_PATH=/liquidacion
# Puerto interno del contenedor (el mismo que ponga en el dominio de Dokploy).
PORT=3000
# Base SQLite y archivos subidos: dentro del volumen montado en /data.
DB_PATH=/data/app.db
UPLOADS_DIR=/data/uploads
TZ=America/Guayaquil

# ---------------------------------------------------------------------------
# Resto de la configuración en Dokploy (no son variables de entorno):
#   Build type ........ Dockerfile
#   Docker file ....... backend/Dockerfile
#   Context path ...... backend
#   Volumes ........... volumen persistente montado en /data   (OBLIGATORIO)
#   Domains ........... Host: midominio.com
#                       Path: /liquidacion/api
#                       Container port: 3000
#                       HTTPS: activado (Let's Encrypt)
#                       Strip Path: DESACTIVADO
# Comprobar: https://midominio.com/liquidacion/api/health  ->  {"ok":true}
