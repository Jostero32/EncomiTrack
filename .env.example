# Copie este archivo a .env (no se sube a git). Todas las variables son opcionales.

# Puerto local del gateway (solo docker-compose.override.yml).
PORT=8080

# Portal académico: clave para subir/eliminar documentos y secreto de la cookie de sesión.
# Sin ellos el portal funciona en solo lectura. SESSION_SECRET: openssl rand -hex 32
ADMIN_PASSCODE=
SESSION_SECRET=
# true cuando se sirve detrás de HTTPS (Dokploy con dominio).
COOKIE_SECURE=false

# Carpeta del equipo con Primer_Parcial/ y Seundo_Parcial/ (PDF del catálogo del semestre).
DOCS_DIR=./documentos

# Nómina: 0 para iniciar sin datos de ejemplo.
CARGAR_DATOS_EJEMPLO=1
TZ=America/Guayaquil
