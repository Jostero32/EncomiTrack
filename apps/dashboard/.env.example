# ─── Administración (subir y eliminar documentos) ──────────────────────────
# Sin estas dos variables el portal funciona en modo solo lectura.
ADMIN_PASSCODE=cambia-esta-clave
# Cadena aleatoria larga para firmar la cookie de sesión (openssl rand -hex 32)
SESSION_SECRET=reemplazar-por-una-cadena-aleatoria-de-64-caracteres

# ─── Archivos ──────────────────────────────────────────────────────────────
# Carpeta que contiene Primer_Parcial/ y Seundo_Parcial/ (material del catálogo, solo lectura).
DOCS_ROOT=..
# Carpeta escribible para documents.json y uploads/ (en Docker es un volumen).
DATA_DIR=.runtime

# ─── Integraciones ─────────────────────────────────────────────────────────
# API del sistema de paz y salvo / liquidación (panel "Datos en vivo" del Módulo 4)
LIQUIDACION_API_URL=http://localhost:8080/liquidacion/api
# true solo si se sirve detrás de HTTPS
COOKIE_SECURE=false
