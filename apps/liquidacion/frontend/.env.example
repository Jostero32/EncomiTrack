# ============================================================================
# Frontend (Angular + nginx) · aplicación de Dokploy con frontend/Dockerfile
# ============================================================================

# --- Pestaña "Build-time Arguments" (se aplica al compilar; OBLIGATORIO si cambia)
BASE_PATH=/liquidacion

# --- Pestaña "Environment" (en tiempo de ejecución)
BASE_PATH=/liquidacion
# Puerto interno de nginx (el mismo que ponga en el dominio de Dokploy).
LISTEN_PORT=8080
# Solo si NO publica el backend en el dominio: nginx reenvía /liquidacion/api aquí.
# Use el nombre interno del servicio del backend que muestra Dokploy.
# BACKEND_URL=http://<nombre-interno-del-backend>:3000

# ---------------------------------------------------------------------------
# Resto de la configuración en Dokploy (no son variables de entorno):
#   Build type ........ Dockerfile
#   Docker file ....... frontend/Dockerfile
#   Context path ...... frontend
#   Domains ........... Host: midominio.com
#                       Path: /liquidacion
#                       Container port: 8080
#                       HTTPS: activado (Let's Encrypt)
#                       Strip Path: DESACTIVADO
# Comprobar: https://midominio.com/liquidacion/
