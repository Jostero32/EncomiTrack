# ============================================================================
# Paz y Salvo y Liquidación (EncomiTrack) · configuración de docker compose
# Copie este archivo a .env y ajuste los valores. .env no se sube a git.
# ============================================================================

# Nombre del proyecto en Docker (contenedores, red y rutas de Traefik).
COMPOSE_PROJECT_NAME=paz-salvo-liquidacion

# ---------------------------------------------------------------- Publicación
# Dominio público (solo lo usa docker-compose.traefik.yml).
DOMAIN=midominio.com
# Subruta donde vive la app: https://DOMAIN/liquidacion/ y la API en /liquidacion/api.
# Sin barra al final. Vacío = servir en la raíz.
BASE_PATH=/liquidacion

# ---------------------------------------------------------------- Puertos internos
# Puertos DENTRO de los contenedores. No se publican en el equipo anfitrión.
BACKEND_PORT=3000
FRONTEND_PORT=8080
# Solo para docker-compose.local.yml: puerto en 127.0.0.1 para probar en su PC.
LOCAL_PORT=8080

# ---------------------------------------------------------------- Datos
# Carpeta del anfitrión con la base SQLite (app.db) y los archivos subidos.
DATA_DIR=./data
TZ=America/Guayaquil

# ---------------------------------------------------------------- Traefik
# Solo para docker-compose.traefik.yml (Traefik existente, p. ej. el de Dokploy).
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
